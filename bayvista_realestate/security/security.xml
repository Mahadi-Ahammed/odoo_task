<odoo>
    <!-- Define a Custom Category -->
    <record id="module_category_bayvista" model="ir.module.category">
        <field name="name">Bay Vista Access Rights</field>
        <field name="description">User roles for Bay Vista property management system</field>
    </record>

    <!-- Admin Group -->
    <record id="group_bayvista_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_bayvista"/>  <!-- Assign to custom category -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Owner Group -->
    <record id="group_bayvista_owner" model="res.groups">
        <field name="name">Owner</field>
        <field name="category_id" ref="module_category_bayvista"/>  <!-- Assign to custom category -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Buyer Group -->
    <record id="group_bayvista_buyer" model="res.groups">
        <field name="name">Buyer</field>
        <field name="category_id" ref="module_category_bayvista"/>  <!-- Assign to custom category -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
