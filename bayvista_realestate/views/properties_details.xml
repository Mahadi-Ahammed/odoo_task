<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="property_details" name="Property details page">
        <t t-call="website.layout">
            <section class="md-container property-detail-section py-5">
                <div class="container">
                    <!-- Property Title -->
                    <h1 class="mb-4" t-esc="prop.name" />

                    <div class="row">

                        <div class="col-md-6">
                            <div class="slider-wrapper" style="position: relative;">

                                <div class="property-images-container" style="position: relative;">
                                    <t t-foreach="images" t-as="img_id">
                                        <div class="property-image" style="display: none;">
                                            <t t-if="img_id">
                                                <img t-att-src="'/web/content/%s' % img_id"
                                                    alt="Property Image"
                                                    style="width: 100%; height: auto;" />
                                            </t>
                                            <t t-if="not img_id">
                                                <img
                                                    src="/bayvista_realestate/static/src/img/placeholder.png"
                                                    alt="Property Image"
                                                    style="width: 100%; height: auto;" />
                                            </t>
                                        </div>
                                    </t>
                                </div>

                                <a href="#" class="slider-prev"
                                    style="position: absolute; top: 50%; left: 5px; transform: translateY(-50%); font-size: 2em; color: #000;">
                                    &#10094;</a>
                                <a href="#" class="slider-next"
                                    style="position: absolute; top: 50%; right: 5px; transform: translateY(-50%); font-size: 2em; color: #000;">
                                    &#10095;</a>
                            </div>
                            <!-- <div class="mapview-container mt-4" style="width: 100%; height:
                            400px;">
                                <widget name="map_view_widget" 
                                    latField="latitude" 
                                    lonField="longitude"
                                    t-att-data-record="{'data': {'latitude': prop.latitude, 'longitude': prop.longitude}}"/>
                            </div> -->

                            <div class="review-booking mt-5">
                                <div class="row">
                                    <div class="col-6">
                                        <button type="button" class="btn btn-primary booking-btn">
                                            Booking</button>
                                    </div>
                                    <div class="col-6 text-end">
                                        <button id="addReview" type="button"
                                            class="btn btn-secondary"
                                            data-bs-toggle="modal" data-bs-target="#reviewModal">
                                            Add Review
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="property-average-rating mt-4">
                                <t t-set="filtered_reviews"
                                    t-value="[review for review in prop.review_ids if review.rating &gt; 0]" />
                                <t t-set="total_reviews" t-value="len(filtered_reviews)" />
                                <t t-set="avg_rating"
                                    t-value="(sum([r.rating for r in prop.review_ids]) / total_reviews) if total_reviews else 0" />
                                <p class="average-rating-text">
                                    <t t-set="format_avg" t-value="'%.1f' % avg_rating" /> Rating: <span
                                        t-esc="format_avg" /> (<span t-esc="total_reviews" />
                                    reviews) </p>
                            </div>
                            <div class="reviews mt-4">
                                <t t-if="reviews">
                                    <t t-foreach="reviews" t-as="review">
                                        <div class="review-item mb-3">
                                            <div class="review-header">
                                                <t t-if="review.property_user_id.image">
                                                    <img
                                                        t-att-src="'/web/image/bay.vista.user/' + str(review.property_user_id.id) + '/image'"
                                                        class="review-profile-img"
                                                        alt="User Profile" />
                                                </t>
                                                <t t-if="not review.property_user_id.image">
                                                    <img
                                                        src="/bayvista_realestate/static/src/img/user_placeholder.png"
                                                        class="review-profile-img"
                                                        alt="User Profile" />
                                                </t>
                                                <a t-att-href="'/bay_vista_user/%s' % review.property_user_id.id" class="review-username">
                                                    <span class=""><t t-esc="review.property_user_id.name"/></span>
                                                    
                                                </a>
                                                
                                                <span class="review-rating">
                                                    <t t-foreach="range(0,5)" t-as="i">
                                                        <i t-if="(i + 1 &lt;= review.rating)"
                                                            class="fa fa-star text-warning"></i>
                                                        <i t-if="(i + 1 &gt; review.rating)"
                                                            class="fa fa-star text-muted"></i>
                                                    </t>
                                                </span>

                                            </div>
                                            <div class="review-comment">
                                                <p t-esc="review.comment" />
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <p>No reviews yet. Be the first to post a review!</p>
                                </t>
                            </div>
                        </div>
                        <div class="modal fade" id="reviewModal" tabindex="-1"
                            aria-labelledby="reviewModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="reviewModalLabel">Add Review</h5>
                                        <button type="button" class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <!-- <input type="hidden" id="current_prop_user"
                                        name="current_prop_user"
                                        t-att-value="current_prop_user.id"/> -->
                                        <div class="star-rating mb-3">
                                            <i class="fa fa-star star" data-value="1"></i>
                                            <i class="fa fa-star star" data-value="2"></i>
                                            <i class="fa fa-star star" data-value="3"></i>
                                            <i class="fa fa-star star" data-value="4"></i>
                                            <i class="fa fa-star star" data-value="5"></i>
                                            <input type="hidden" id="review_rating" name="rating"
                                                value="0" />
                                        </div>
                                        <textarea name="comment" id="review_comment_text" rows="4"
                                            class="form-control"
                                            placeholder="Write your review here..."></textarea>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                            Close</button>
                                        <button type="button" id="saveReview"
                                            t-att-data-curr_prop_id="prop.id"
                                            t-att-data-curr_prop_user="current_prop_user.id"
                                            class="btn btn-primary">Add</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Property Information (Right Column) -->
                        <div class="col-md-6">
                            <div class="property-info">
                                <h3>Property Information</h3>
                                <ul class="list-unstyled">
                                    <li>
                                        <strong>Address:</strong> 
                            <span t-esc="prop.street" /> , <span
                                            t-esc="prop.city" /> , <span t-esc="prop.state_id.name" />
                                        , <span t-esc="prop.zip_code" /> , <span
                                            t-esc="prop.country_id.name" />
                                    </li>
                                    <li>
                                        <strong>Bedrooms:</strong>
                                        <span t-esc="prop.number_bed" />
                                    </li>
                                    <li>
                                        <strong>Bathrooms:</strong>
                                        <span t-esc="prop.number_bath" />
                                    </li>
                                    <li>
                                        <strong>Square Feet:</strong>
                                        <span t-esc="prop.square_feet" />
                                    </li>
                                    <li>
                                        <strong>Property For:</strong>
                                        <span t-esc="prop.property_for.capitalize()" />
                                    </li>
                                </ul>

                                <h3>Facilities &amp; Features</h3>
                                <p t-esc="prop.facilities" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="user_profile_page" name="Property User Profile">
        <t t-call="website.layout">
            <section class="md-container profile-section py-5">
                <div class="container">
                    <div class="profile-header text-center mb-4">
                        <t t-if="user_profile.image">
                            <img
                                t-att-src="'/web/image/bay.vista.user/' + str(user_profile.id) + '/image'"
                                class="profile-img rounded-circle"
                                alt="Profile Picture" />
                        </t>
                        <t t-if="not user_profile.image">
                            <img
                                src="/bayvista_realestate/static/src/img/user_placeholder.png"
                                class="profile-img rounded-circle"
                                alt="Profile Picture" />
                        </t>
                        <h1 class="mt-3" t-esc="user_profile.name" />
                        <p class="text-muted" t-esc="user_profile.email" />
                        <p>
                            <strong t-esc="user_profile.role.capitalize()" />
                        </p>
                    </div>
                    <div class="profile-details">
                        <h3>Contact Information</h3>
                        <p>
                            <strong>Address: </strong>
                    <span
                                t-esc="user_profile.street" />, <span
                                t-esc="user_profile.city" />, <span
                                t-esc="user_profile.zip_code" />
                        </p>
                        <t t-if="user_profile.country_id">
                            <p>
                                <strong>Country: </strong>
                                <span t-esc="user_profile.country_id.name" />
                            </p>
                        </t>
                        <t t-if="user_profile.state_id">
                            <p>
                                <strong>State: </strong>
                                <span t-esc="user_profile.state_id.name" />
                            </p>
                        </t>
                    </div>
                    <t t-if="can_edit">
                        <div class="profile-actions text-center mt-4">
                            <button type="button"
                                class="btn btn-primary edit-profile-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#editProfileModal">
                                Edit Profile
                            </button>
                        </div>
                    </t>
                </div>
                <!-- Edit Profile Modal -->
                <div class="modal fade" id="editProfileModal" tabindex="-1"
                    aria-labelledby="editProfileModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="editProfileModalLabel">Edit
                                    Profile</h5>
                                <button type="button" class="btn-close"
                                    data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form id="editProfileForm">
                                    <div class="mb-3">
                                        <label for="profileName" class="form-label">Full
                                            Name</label>
                                        <input type="text" class="form-control"
                                            id="profileName" name="name"
                                            t-att-value="user_profile.name" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="profileEmail" class="form-label">
                                            Email</label>
                                        <input type="email" class="form-control"
                                            id="profileEmail" name="email"
                                            t-att-value="user_profile.email" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="profileStreet" class="form-label">
                                            Street</label>
                                        <input type="text" class="form-control"
                                            id="profileStreet" name="street"
                                            t-att-value="user_profile.street" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="profileCity" class="form-label">City</label>
                                        <input type="text" class="form-control"
                                            id="profileCity" name="city"
                                            t-att-value="user_profile.city" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="profileZip" class="form-label">ZIP
                                            Code</label>
                                        <input type="text" class="form-control"
                                            id="profileZip" name="zip_code"
                                            t-att-value="user_profile.zip_code" />
                                    </div>
                                    <!-- Additional fields for country and state could
                            be added here -->
                                    <input type="hidden" name="user_id"
                                        t-att-value="user_profile.odoo_user_id.id" />
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">Close</button>
                                <button type="button" id="saveProfile"
                                    class="btn btn-primary">Save changes</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


        </t>
    </template>
</odoo>