<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="bay_properties_template" model="website.page">
            <field name="name">Properties</field>
            <field name="url">/properties</field>
            <field name="type">qweb</field>
            <field name="visibility">connected</field>
            <field name="is_published">True</field>
            <field name="website_indexed" eval="True" />
            <field name="website_id" ref="website.default_website" />
            <field name="key">bayvista_realestate.properties_page</field>
            <field name="arch" type="xml">
                <t t-name="bayvista_realestate.properties_page">
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure">
                            <section class="md-container properties-section py-5">
                                <div class="container">
                                    <h1 class="text-center mb-4">Properties</h1>
                                    <div class="mb-4">
                                        <a href="/properties" class="btn m-1"
                                            t-attf-class="btn {{ 'btn-secondary' if current_filter == 'all' else 'btn-primary' }}">
                                            All</a>
                                        <a href="/properties?filter=sale" class="btn m-1"
                                            t-attf-class="btn {{ 'btn-secondary' if current_filter == 'sale' else 'btn-primary' }}">
                                            Sale</a>
                                        <a href="/properties?filter=rent" class="btn m-1"
                                            t-attf-class="btn {{ 'btn-secondary' if current_filter == 'rent' else 'btn-primary' }}">
                                            Rent</a>
                                    </div>
                                    
                                    <div class="row">

                                        <t t-foreach="properties" t-as="property">
                                            <div class="col-sm-12 col-md-6 col-lg-4 mb-4">

                                                <a t-att-href="'/properties/details/%s' % property.get('id')" style="text-decoration: none; color: inherit;">
                                                    <div class="card h-100">

                                                        <t t-if="property.get('attachment_id')">
                                                            <img
                                                                t-att-src="'/web/content/%s' % property.get('attachment_id')"
                                                                class="card-img-top"
                                                                alt="Property Image" />
                                                        </t>
    
                                                        <t t-if="not property.get('attachment_id')">
                                                            <img
                                                                src="/bayvista_realestate/static/src/img/placeholder.png"
                                                                class="card-img-top"
                                                                alt="Property Image" />
                                                        </t>
                                                        <div class="card-body">
                                                            <h5 class="card-title"
                                                                t-esc="property.get('name')" />
    
                                                            <p class="card-text"
                                                                t-esc="property.get('full_address')" />
                                                        </div>
                                                        <div class="card-footer text-muted">
                                                            <span
                                                                t-esc="property.get('property_for').capitalize()" />
                                                        </div>
                                                    </div>
                                                </a>
                                                
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </t>
                </t>
            </field>
        </record>
    </data>
</odoo>